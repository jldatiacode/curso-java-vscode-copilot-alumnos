<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- El proyecto hereda de Spring Boot: versiones de dependencias y plugins ya gestionadas -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <groupId>curso.docker</groupId>
    <artifactId>tareas-docker</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <name>Gestor de tareas: API REST en Docker</name>

    <properties>
        <java.version>21</java.version>
    </properties>

    <dependencies>
        <!-- API REST: Spring MVC, Jackson y Tomcat embebido -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <!-- Validación de las peticiones (@NotBlank, @Size, @NotNull…) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- Pruebas de Spring MVC: MockMvc, y por transitividad JUnit, AssertJ… -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- Nombre fijo del JAR (target/tareas-docker.jar): el Dockerfile lo copia por su nombre -->
        <finalName>${project.artifactId}</finalName>
        <plugins>
            <!-- JAR ejecutable con todas las dependencias (java -jar) -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
