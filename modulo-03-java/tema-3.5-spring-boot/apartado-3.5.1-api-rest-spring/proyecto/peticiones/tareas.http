# Peticiones de prueba de la API de tareas.
# Se ejecutan con la extensión REST Client: clic en "Send Request" sobre cada petición.
# La aplicación debe estar arrancada en el puerto 8080.

@base = http://localhost:8080/api/tareas

### Listar todas las tareas
GET {{base}}

### Consultar una tarea
GET {{base}}/2

### Consultar una tarea inexistente (404)
GET {{base}}/999

### Crear una tarea (201)
POST {{base}}
Content-Type: application/json

{
  "titulo": "Preparar la demo",
  "descripcion": "Creada desde el archivo .http"
}

### Crear una tarea sin título (400)
POST {{base}}
Content-Type: application/json

{
  "titulo": ""
}

### Cambiar el estado de una tarea (200)
PATCH {{base}}/3/estado
Content-Type: application/json

{
  "estado": "EN_PROGRESO"
}

### Cambiar el estado de una tarea completada (409)
PATCH {{base}}/1/estado
Content-Type: application/json

{
  "estado": "PENDIENTE"
}

### Estado desconocido (400)
PATCH {{base}}/2/estado
Content-Type: application/json

{
  "estado": "CANCELADA"
}
